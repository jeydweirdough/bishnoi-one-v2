# Copy to .env.local in the app that needs it. Never commit real values.

# Neon PostgreSQL (server-side only). Leave unset to run every app on mock data.
DATABASE_URL=

# Optional: override where the portal launcher links each app.
# Defaults to http://localhost:<port> (see packages/contracts/src/apps.ts).
# NEXT_PUBLIC_APP_URL_INVENTORY=https://inventory.example.com
